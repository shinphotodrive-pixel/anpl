    function updatePhysicsChart(tUs, pObj) {
      if (!physicsChartInstance) return;
      const speeds = [10, 30, 50, 70, 90, 110, 130, 150];
      const blurData = speeds.map(vKmh => {
        const vMms = (vKmh * 1000000) / 3600;
        const blurMm = vMms * (tUs / 1000000);
        return parseFloat((blurMm / pObj).toFixed(2));
      });

      physicsChartInstance.data.datasets[0].data = blurData;
      physicsChartInstance.update();
    }

