    // -------------------------------------------------------------------------
    // TAB 2: OPTICAL PHYSICS CALCULATOR
    // -------------------------------------------------------------------------
    function updatePhysicsCalc() {
      const vKmh = parseFloat(document.getElementById('input-speed').value);
      const tUs = parseFloat(document.getElementById('input-exp').value);
      const pObj = parseFloat(document.getElementById('input-res').value);
      const latMs = parseFloat(document.getElementById('input-latency').value);

      // Label updates
      document.getElementById('val-speed-txt').textContent = `${vKmh} km/h`;
      document.getElementById('val-exp-txt').textContent = `${tUs} µs (1/${Math.round(1000000/tUs)}s)`;
      document.getElementById('val-res-txt').textContent = `${pObj.toFixed(1)} mm/px`;

      const latLabels = { 1: "1 ms (HW Pin)", 50: "50 ms (IP Cam)", 200: "200 ms (SW Trigger)" };
      document.getElementById('val-lat-txt').textContent = latLabels[latMs] || `${latMs} ms`;

      // Calculations
      // v (mm/s) = vKmh * 1,000,000 / 3600
      const vMms = (vKmh * 1000000) / 3600;
      const vMs = (vKmh / 3.6); // m/s
      const tSec = tUs / 1000000;

      // Blur b = v * t
      const blurMm = vMms * tSec;
      const blurPx = blurMm / pObj;

      // t_max for 1px smear: t_max = (1 * pObj) / vMms
      const tMaxSec = (1.0 * pObj) / vMms;
      const tMaxUs = Math.round(tMaxSec * 1000000);

      // Latency Distance: dist = v_ms * latMs
      const latDistMm = vMs * latMs;

      // Update Result Box
      document.getElementById('res-velocity-ms').textContent = `${vMs.toFixed(2)} m/s`;
      document.getElementById('res-blur-mm').textContent = `${blurMm.toFixed(2)} mm`;
      document.getElementById('res-blur-px').textContent = `${blurPx.toFixed(2)} px`;
      document.getElementById('res-tmax-us').textContent = `${tMaxUs} µs`;
      document.getElementById('res-lat-dist').textContent = `${(latDistMm / 10).toFixed(2)} cm (${latDistMm.toFixed(1)} mm)`;

      // Status Badge
      const statusBadge = document.getElementById('blur-status-badge');
      if (blurPx <= 1.0) {
        statusBadge.className = "text-xs px-2.5 py-0.5 rounded font-bold bg-emerald-100 text-emerald-700";
        statusBadge.textContent = "선명함 (ANPR OCR 인식 우수)";
      } else if (blurPx <= 2.5) {
        statusBadge.className = "text-xs px-2.5 py-0.5 rounded font-bold bg-amber-100 text-amber-700";
        statusBadge.textContent = "미세 번짐 (조명 보정 필요)";
      } else {
        statusBadge.className = "text-xs px-2.5 py-0.5 rounded font-bold bg-red-100 text-red-700";
        statusBadge.textContent = "심한 모션 블러 (OCR 판독 불가)";
      }

      // Update Physics Chart
      updatePhysicsChart(tUs, pObj);
    }

