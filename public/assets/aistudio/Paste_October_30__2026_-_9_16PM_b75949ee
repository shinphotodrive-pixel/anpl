    function validatePlateRegex() {
      const input = document.getElementById('regexInput').value.trim();
      const rawSpan = document.getElementById('regex-raw');
      const formatSpan = document.getElementById('regex-format');
      const correctedSpan = document.getElementById('regex-corrected');
      const statusSpan = document.getElementById('regex-status');

      rawSpan.innerText = input || "(빈 값)";

      if (!input) {
        formatSpan.innerText = "-";
        correctedSpan.innerText = "-";
        statusSpan.innerText = "대기중";
        statusSpan.className = "bg-slate-800 text-slate-400 px-2 py-0.5 rounded";
        return;
      }

      // Korean Plate Pattern Matching
      // Pattern 1: 8-digit (123가4568)
      const pattern8 = /^(\d{2,3})([O0-9])([가-힣])(\d{4})$/;
      // Pattern 2: 7-digit (12가3456)
      const pattern7 = /^(\d{2})([가-힣])(\d{4})$/;
      // Pattern 3: Regional (서울12가3456)
      const patternRegion = /^([가-힣]{2})(\d{2})([가-힣])(\d{4})$/;

      let corrected = input;
      let matchedFormat = "알 수 없는 규격";
      let isValid = false;

      // Check O -> 0 misrecognition
      if (pattern8.test(input)) {
        matchedFormat = "신형 8자리 비사업용 (RPA3)";
        const match = input.match(pattern8);
        let numPart1 = match[1];
        let possO = match[2];
        let hangul = match[3];
        let numPart2 = match[4];

        if (possO === 'O') possO = '0';
        corrected = `${numPart1}${possO}${hangul} ${numPart2}`;
        isValid = true;
      } else if (input.includes('O') || input.includes('B')) {
        // Auto-fix misrecognitions
        let temp = input.replace(/O/g, '0').replace(/B/g, '8');
        if (pattern8.test(temp)) {
          matchedFormat = "신형 8자리 (휴리스틱 교정 적용)";
          const match = temp.match(pattern8);
          corrected = `${match[1]}${match[2]}${match[3]} ${match[4]}`;
          isValid = true;
        }
      }

      if (!isValid && pattern7.test(input)) {
        matchedFormat = "구형 7자리 일반 (RPA1/2)";
        const match = input.match(pattern7);
        corrected = `${match[1]}${match[2]} ${match[3]}`;
        isValid = true;
      }

      if (!isValid && patternRegion.test(input)) {
        matchedFormat = "지역명이 포함된 영업용/특수 번호판";
        const match = input.match(patternRegion);
        corrected = `${match[1]} ${match[2]}${match[3]} ${match[4]}`;
        isValid = true;
      }

      if (isValid) {
        formatSpan.innerText = matchedFormat;
        correctedSpan.innerText = corrected;
        statusSpan.innerText = "PASSED (자동 교정 및 규격 일치)";
        statusSpan.className = "bg-emerald-950 text-emerald-400 px-2 py-0.5 rounded border border-emerald-800";
      } else {
        formatSpan.innerText = "규격 불일치";
        correctedSpan.innerText = input;
        statusSpan.innerText = "WARNING (정규표현식 검증 실패)";
        statusSpan.className = "bg-red-950 text-red-400 px-2 py-0.5 rounded border border-red-800";
      }
    }

