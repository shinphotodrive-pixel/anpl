                  <p>• <strong>광학 기술:</strong> LightHunter 저조도 기술 + 2.7~13.5mm 전동 가변 초점 렌즈</p>
                  <p>• <strong>Smart IR:</strong> 화각 줌 인/아웃에 연동되어 빔 방사각 자동 수축/확장 (근거리 타들어감 예방)</p>
                  <p>• <strong>시나리오:</strong> 보행자 자동 인식, 스마트 횡단보도, WDR 조도 균형을 통한 차량/사람 동시 정밀 분석.</p>`
      }
    };

    function selectVendor(key) {
      ['geona', 'seo', 'unisecu'].forEach(v => {
        const card = document.getElementById('vcard-' + v);
        if (v === key) {
          card.classList.add('border-blue-500');
          card.classList.remove('border-slate-200');
        } else {
          card.classList.remove('border-blue-500');
          card.classList.add('border-slate-200');
        }
      });

      const detail = vendorDetails[key];
      document.getElementById('vdetailTitle').innerText = detail.title;
      const tagEl = document.getElementById('vdetailTag');
      tagEl.innerText = detail.tag;
      tagEl.className = 'text-xs font-bold px-2 py-0.5 rounded ' + detail.tagClass;
      document.getElementById('vdetailContent').innerHTML = detail.content;
    }

    function updateSimulator() {
      const weather = document.getElementById('simWeather').value;
      const plate = document.getElementById('simPlate').value;
      const smartIr = document.getElementById('simSmartIr').checked;
      const exir = document.getElementById('simExir').checked;

      let power = 100;
      let pulseMs = 4.5;
      let isBlooming = false;
      let isBackscatter = (weather === 'fog');
      let recSuccess = true;

      if (plate === 'film') {
        if (!smartIr && !exir) {
          isBlooming = true;
          recSuccess = false;
        } else if (smartIr && !exir) {
          power = 40;
          pulseMs = 1.2;
          isBlooming = false;
          recSuccess = true;
        } else if (!smartIr && exir) {
          power = 60;
          pulseMs = 2.0;
          isBlooming = false;
          recSuccess = true;
        } else {
          power = 35;
          pulseMs = 1.0;
          isBlooming = false;
          recSuccess = true;
        }
      } else {
        power = 75;
        pulseMs = 3.0;
        isBlooming = false;
        recSuccess = true;
      }

      if (isBackscatter && !smartIr) {
        recSuccess = false;
      }

      document.getElementById('simPowerReadout').innerText = power + '% Power';
      document.getElementById('simPulseReadout').innerText = pulseMs + ' ms';
      document.getElementById('simReflectReadout').innerText = (plate === 'film') ? 'High (28 cd)' : 'Normal (8 cd)';
      document.getElementById('simScatterReadout').innerText = isBackscatter ? 'High (Rain/Fog)' : 'Low (1%)';

      const badge = document.getElementById('simStatusBadge');
      if (isBlooming) {
        badge.innerText = '과노출 판독 불가 (Blooming Fail)';
        badge.className = 'text-xs px-2.5 py-0.5 rounded font-bold bg-red-500 text-white';
      } else if (isBackscatter && !smartIr) {
        badge.innerText = '안개 빛 산란 판독 실패 (23% Baseline)';
        badge.className = 'text-xs px-2.5 py-0.5 rounded font-bold bg-amber-500 text-slate-950';
      } else {
        badge.innerText = '정상 픽셀 수집 (인식률 99.2%)';
        badge.className = 'text-xs px-2.5 py-0.5 rounded font-bold bg-emerald-500 text-slate-950';
      }

      renderSimCanvas(isBlooming, isBackscatter, smartIr, exir, plate);
    }

    function renderSimCanvas(isBlooming, isBackscatter, smartIr, exir, plate) {
      const canvas = document.getElementById('simCanvas');
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = '#334155';
      ctx.fillRect(80, 20, 320, 140);
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(100, 30, 280, 100);

      ctx.fillStyle = (plate === 'film') ? '#f1f5f9' : '#cbd5e1';
      ctx.fillRect(160, 90, 160, 35);
      ctx.strokeStyle = '#0284c7';
      ctx.lineWidth = 2;
      ctx.strokeRect(160, 90, 160, 35);

      if (isBlooming) {
        const grad = ctx.createRadialGradient(240, 107, 5, 240, 107, 70);
        grad.addColorStop(0, 'rgba(255, 255, 255, 1.0)');
        grad.addColorStop(0.5, 'rgba(255, 255, 255, 0.8)');
        grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(240, 107, 75, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#ef4444';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText('[IR BLOOMING WARNING]', 165, 60);
      } else {
        ctx.fillStyle = '#0f172a';
        ctx.font = 'bold 16px sans-serif';
        ctx.fillText('123가 4567', 195, 114);
      }

      if (isBackscatter) {
        ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
        for (let i = 0; i < 40; i++) {
          let rx = (i * 13) % canvas.width;
          let ry = (i * 29) % canvas.height;
          ctx.beginPath();
          ctx.arc(rx, ry, (i % 3) + 1, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      ctx.fillStyle = '#10b981';
      ctx.font = '10px monospace';
      ctx.fillText('FPS: 60 | RAW IR BUFFER', 10, 15);
      if (smartIr) ctx.fillText('SMART-IR: ACTIVE', 360, 15);
    }
  </script>
