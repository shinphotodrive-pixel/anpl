        drawPerspectiveWarp(isWarped);
    }

    function drawPerspectiveWarp(warped) {
        const canvas = document.getElementById('perspectiveWarpCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        canvas.width = canvas.parentElement.clientWidth - 32;
        canvas.height = 140;
        const w = canvas.width;
        const h = canvas.height;

        ctx.clearRect(0, 0, w, h);

        if (!warped) {
            // Skewed Trapezoid Plate Representation
            const p1 = { x: w * 0.25, y: h * 0.3 };
            const p2 = { x: w * 0.80, y: h * 0.15 };
            const p3 = { x: w * 0.70, y: h * 0.85 };
            const p4 = { x: w * 0.20, y: h * 0.75 };

            // Fill polygon
            ctx.fillStyle = '#1e293b';
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y);
            ctx.lineTo(p3.x, p3.y); ctx.lineTo(p4.x, p4.y);
            ctx.closePath();
            ctx.fill();
            ctx.strokeStyle = '#eab308';
            ctx.lineWidth = 2;
            ctx.stroke();

            // Keypoints
            [p1, p2, p3, p4].forEach((p, idx) => {
                ctx.fillStyle = '#ef4444';
                ctx.beginPath();
                ctx.arc(p.x, p.y, 5, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#ffffff';
                ctx.font = '10px JetBrains Mono';
                ctx.fillText(`K${idx+1}`, p.x - 12, p.y - 8);
            });
        } else {
            // Rectified Plate
            const rx = w * 0.2;
            const ry = h * 0.25;
            const rw = w * 0.6;
            const rh = h * 0.5;

            ctx.fillStyle = '#0f172a';
            ctx.fillRect(rx, ry, rw, rh);
            ctx.strokeStyle = '#10b981';
            ctx.lineWidth = 3;
            ctx.strokeRect(rx, ry, rw, rh);

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 18px JetBrains Mono';
            ctx.fillText("52가 3491", rx + rw * 0.25, ry + rh * 0.65);
        }
    }

