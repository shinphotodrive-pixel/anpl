    // -------------------------------------------------------------
    // TAB 4: Shutter Latency Physical Displacement Calculator
    // -------------------------------------------------------------
    function calculateDisplacement() {
        const speedKmH = parseFloat(document.getElementById('inputSpeed').value);
        const latencyMs = parseFloat(document.getElementById('inputLatency').value);

        document.getElementById('speedValText').innerText = `${speedKmH} km/h`;
        document.getElementById('latencyValText').innerText = `${latencyMs} ms`;

        // d = v * t (v in m/s, t in seconds)
        const speedMS = speedKmH / 3.6;
        const latencySec = latencyMs / 1000;
        const distMeters = speedMS * latencySec;

        const resEl = document.getElementById('calcDistanceResult');
        const evalEl = document.getElementById('calcEvalText');

        resEl.innerText = `${distMeters.toFixed(2)} m`;

        if (distMeters < 0.5) {
            evalEl.innerText = "평가: 머신비전 (1ms) 레벨 - 타깃 위치 오차 거의 없음 (최상)";
            evalEl.className = "text-xs text-emerald-300";
        } else if (distMeters < 2.0) {
            evalEl.innerText = "평가: 교통 전용 IP 카메라 (30~50ms) - 바운딩 박스 추적 안정권 내 포착";
            evalEl.className = "text-xs text-indigo-300";
        } else {
            evalEl.innerText = "평가: 일반 감시 IP 카메라 (200ms↑) - 차량이 화면 밖으로 이탈하거나 크롭 이탈 위험 고조";
            evalEl.className = "text-xs text-rose-300";
        }
    }

