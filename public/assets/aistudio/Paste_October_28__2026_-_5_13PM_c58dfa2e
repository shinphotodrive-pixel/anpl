    function spawnLiveVehicle(type = 'normal') {
        const isCorp = type === 'corporate';
        const plateStr = isCorp ? `77법 ${Math.floor(Math.random()*8999+1000)}` : `${Math.floor(Math.random()*89+10)}가 ${Math.floor(Math.random()*8999+1000)}`;

        const car = {
            x: -80,
            y: liveCanvas.height / 2 - 15,
            width: 70,
            height: 32,
            speed: Math.random() * 2 + 3,
            plate: plateStr,
            isCorp: isCorp,
            logged: false
        };
        liveVehicles.push(car);
    }

    function toggleAutoSim() {
        const btnText = document.getElementById('autoSimText');
        if (autoSimTimer) {
            clearInterval(autoSimTimer);
            autoSimTimer = null;
            btnText.innerText = "자동 트래픽 시작";
        } else {
            autoSimTimer = setInterval(() => {
                const type = Math.random() > 0.4 ? 'normal' : 'corporate';
                spawnLiveVehicle(type);
            }, 2500);
            btnText.innerText = "자동 트래픽 중지";
        }
    }

    function renderLiveRoad() {
        if (!liveCanvas) return;
        const w = liveCanvas.width;
        const h = liveCanvas.height;

        liveCtx.clearRect(0, 0, w, h);

        // Draw Road background & lane
        liveCtx.fillStyle = '#0f172a';
        liveCtx.fillRect(0, 0, w, h);

        liveCtx.strokeStyle = '#334155';
        liveCtx.setLineDash([15, 15]);
        liveCtx.lineWidth = 2;
        liveCtx.beginPath();
        liveCtx.moveTo(0, h / 2);
        liveCtx.lineTo(w, h / 2);
        liveCtx.stroke();
        liveCtx.setLineDash([]);

        // Camera Detection Zone line
        const trapX = w * 0.55;
        liveCtx.strokeStyle = 'rgba(99, 102, 241, 0.6)';
        liveCtx.lineWidth = 2;
        liveCtx.beginPath();
        liveCtx.moveTo(trapX, 0);
        liveCtx.lineTo(trapX, h);
        liveCtx.stroke();

        // Update & Render Vehicles
        for (let i = liveVehicles.length - 1; i >= 0; i--) {
            let v = liveVehicles[i];
            v.x += v.speed;

            // Draw Car Box
            liveCtx.fillStyle = v.isCorp ? '#059669' : '#3b82f6';
            liveCtx.fillRect(v.x, v.y, v.width, v.height);

            // Draw YOLO Bounding Box & Keypoints overlay
            liveCtx.strokeStyle = '#eab308';
            liveCtx.lineWidth = 1.5;
            liveCtx.strokeRect(v.x + 10, v.y + 8, 24, 14);

            // Check Detection Trigger Line
            if (v.x > trapX && !v.logged) {
                v.logged = true;
                addLogEvent(v.plate, v.isCorp ? '2024 연두색' : '일반 승용', (Math.random() * 0.05 + 0.94).toFixed(3));
            }

            // Remove out of screen
            if (v.x > w + 100) {
                liveVehicles.splice(i, 1);
            }
        }

        requestAnimationFrame(renderLiveRoad);
    }

    function addLogEvent(plate, type, conf) {
        const tbody = document.getElementById('logTableBody');
        // Clear placeholder if first
        if (tbody.children.length === 1 && tbody.children[0].children.length === 1) {
            tbody.innerHTML = '';
        }

        const timeStr = new Date().toLocaleTimeString('ko-KR', { hour12: false });
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition";
        tr.innerHTML = `
            <td class="p-2 text-slate-500">${timeStr}</td>
            <td class="p-2 font-bold text-slate-900">${plate}</td>
            <td class="p-2"><span class="px-1.5 py-0.5 rounded text-[10px] font-bold ${type === '2024 연두색' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700'}">${type}</span></td>
            <td class="p-2 text-emerald-600 font-bold">${conf}</td>
        `;
        tbody.insertBefore(tr, tbody.firstChild);
    }

    function clearLogs() {
        const tbody = document.getElementById('logTableBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="4" class="p-6 text-center text-slate-400 font-sans">
                    아직 감지된 차량 이벤트가 없습니다. 왼쪽 버튼으로 차량을 발생시켜 보세요.
                </td>
            </tr>
        `;
    }
</script>
</body>
