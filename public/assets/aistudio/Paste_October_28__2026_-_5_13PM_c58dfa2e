    function updateZeroDceSim(val) {
        const factor = (val / 100).toFixed(2);
        document.getElementById('zeroDceVal').innerText = factor;
        drawToneCurve(val);
    }

    function drawToneCurve(val) {
        const canvas = document.getElementById('toneCurveCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        canvas.width = canvas.parentElement.clientWidth - 32;
        canvas.height = 140;

        const w = canvas.width;
        const h = canvas.height;

        ctx.clearRect(0, 0, w, h);

        // Draw grid
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 1;
        ctx.beginPath();
        for(let x = 0; x < w; x += 30) { ctx.moveTo(x, 0); ctx.lineTo(x, h); }
        for(let y = 0; y < h; y += 30) { ctx.moveTo(0, y); ctx.lineTo(w, y); }
        ctx.stroke();

        // Draw Linear Baseline (y=x)
        ctx.strokeStyle = '#64748b';
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(30, h - 20);
        ctx.lineTo(w - 20, 20);
        ctx.stroke();
        ctx.setLineDash([]);

        // Draw Zero-DCE Enhanced Curve: LE_n(I) = I + alpha * I * (1 - I)
        const alpha = (val / 100) * 2.5;
        ctx.strokeStyle = '#6366f1';
        ctx.lineWidth = 3;
        ctx.beginPath();
        for (let i = 0; i <= 100; i++) {
            let xNorm = i / 100;
            let yNorm = xNorm + alpha * xNorm * (1 - xNorm);
            yNorm = Math.min(1, yNorm);

            let px = 30 + xNorm * (w - 50);
            let py = (h - 20) - yNorm * (h - 40);

            if (i === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
        }
        ctx.stroke();
    }

    let isWarped = false;
    function toggleWarpState() {
        isWarped = !isWarped;
        const btn = document.getElementById('warpToggleBtn');
        const txt = document.getElementById('warpStatusText');
        if (isWarped) {
            btn.innerText = "원근 복원 초기화";
            txt.innerText = "상태: Perspective Transform 적용 완료 (정면 View)";
